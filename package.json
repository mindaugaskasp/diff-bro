{
  "name": "diffbro",
  "version": "0.1.0",
  "description": "Desktop file diff viewer with GitHub-style rendering",
  "main": "./build/main/index.js",
  "author": "Mindaugas",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
